# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# ---- Server ----
PORT=3000
NODE_ENV=development
# Origin of the frontend dev server, needed for CORS + cookies to work together
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ----
# Prisma's SQLite connection format. This resolves relative to
# server/prisma/schema.prisma, so it creates server/prisma/dev.db.
# Later, to move to PostgreSQL, this becomes something like:
# postgresql://user:password@localhost:5432/clouddrive
DATABASE_URL="file:./dev.db"

# ---- Storage provider ----
# "local" for now. Later: "s3"
STORAGE_PROVIDER=local
# Relative to server/, since that's where npm scripts run from —
# this points at the storage/ folder at the project root.
LOCAL_STORAGE_PATH=../storage

# ---- S3 / S3-compatible storage (used later, in Phase 13) ----
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Auth ----
# Signs the login token stored in an httpOnly cookie. Generate one with:
# `openssl rand -hex 32` (Mac/Linux) or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=

# ---- Uploads ----
MAX_UPLOAD_SIZE_MB=500
